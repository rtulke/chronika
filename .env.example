# Copy to .env and adjust. Loaded by setup_env.sh and activate_env.sh.
# .env is gitignored; delete it or leave PROXY_URL empty if you need no proxy.

# HTTP(S) proxy used by pip and python
PROXY_URL=http://proxy.example.com:8080

# Hosts that bypass the proxy (comma-separated)
NO_PROXY_LIST=127.0.0.1,localhost
